data/
*.csv
*.xlsx
*.parquet
*.sqlite3

# Mật khẩu CSDL
.env

# Mô hình đã train (sinh lại bằng các file scripts/*.py)
Assets/*.joblib
Assets/*.pkl
Assets/catboost_info/

# Hệ điều hành Mac
.DS_Store

# Triển khai: web cần đúng mô hình tốt nhất + bảng metric (ghi đè các luật ở trên)
!Assets/best_model.joblib
!Assets/reports/metrics.csv

# Tài liệu nặng không cần cho web
Slides/
popup/
Assets/figures/

